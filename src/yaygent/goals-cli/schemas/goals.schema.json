{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "goals.schema.json",
  "title": "Goals Definition",
  "description": "Schema for defining goals for AI workflow orchestration",
  "type": "object",
  "required": ["version", "goals"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version (e.g., '1.0')"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { 
          "type": "string",
          "description": "Name of the goals definition"
        },
        "description": { 
          "type": "string",
          "description": "Description of the goals"
        },
        "author": { 
          "type": "string",
          "description": "Author of the goals definition"
        },
        "created": { 
          "type": "string", 
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "tags": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Tags for categorization"
        }
      },
      "additionalProperties": true
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/goal" },
      "description": "Array of goal definitions"
    },
    "globalContext": {
      "type": "object",
      "description": "Key-value pairs available to all goals",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "goal": {
      "type": "object",
      "required": ["id", "objective"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique identifier (kebab-case)"
        },
        "objective": {
          "type": "string",
          "minLength": 10,
          "description": "Clear statement of what should be accomplished"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Priority level (1=highest, 10=lowest)"
        },
        "criteria": {
          "$ref": "#/definitions/criteria",
          "description": "Success and acceptance criteria"
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Limitations or restrictions"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of goals that must complete first"
        },
        "context": {
          "type": "object",
          "description": "Goal-specific context key-value pairs",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "properties": {
        "success": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Conditions that define success"
        },
        "acceptance": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Minimum requirements for acceptance"
        },
        "validation": {
          "type": "string",
          "enum": ["manual", "automated", "hybrid"],
          "default": "manual",
          "description": "How success will be validated"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
