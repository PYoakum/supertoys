{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "personas.schema.json",
  "title": "Personas Definition",
  "description": "Schema for defining personas for AI-guided content composition",
  "type": "object",
  "required": ["version", "personas"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version (e.g., '1.0')"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the personas collection"
        },
        "description": {
          "type": "string",
          "description": "Description of the personas collection"
        },
        "author": {
          "type": "string",
          "description": "Author of the personas definition"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags for categorization"
        }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "description": "Default values applied to all personas",
      "properties": {
        "language": {
          "$ref": "#/definitions/languageConfig"
        },
        "formality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        }
      },
      "additionalProperties": true
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/persona" },
      "description": "Array of persona definitions"
    }
  },
  "definitions": {
    "persona": {
      "type": "object",
      "required": ["name", "displayName", "tone", "personality"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-_]*$",
          "description": "Unique identifier (kebab-case with underscores allowed)"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief description of the persona"
        },
        "tone": {
          "$ref": "#/definitions/toneConfig"
        },
        "personality": {
          "$ref": "#/definitions/personalityConfig"
        },
        "language": {
          "$ref": "#/definitions/languageConfig"
        },
        "motivations": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10,
          "description": "Driving motivations for the persona"
        },
        "wordChoice": {
          "$ref": "#/definitions/wordChoiceConfig"
        },
        "emotion": {
          "$ref": "#/definitions/emotionConfig"
        },
        "contextModifiers": {
          "type": "object",
          "description": "Situational adjustments to persona attributes",
          "additionalProperties": {
            "$ref": "#/definitions/contextModifier"
          }
        }
      },
      "additionalProperties": false
    },
    "toneConfig": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "professional",
            "casual",
            "formal",
            "friendly",
            "authoritative",
            "empathetic",
            "enthusiastic",
            "neutral",
            "serious",
            "playful",
            "supportive",
            "direct",
            "diplomatic",
            "inspirational",
            "conversational"
          ],
          "description": "Primary tone descriptor"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "description": "Supporting tone qualities"
        },
        "formality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Formality level (1=very casual, 10=very formal)"
        },
        "warmth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Warmth level (1=cold/distant, 10=very warm)"
        },
        "assertiveness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Assertiveness level (1=passive, 10=very assertive)"
        },
        "humor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Humor inclusion (1=none, 10=frequent)"
        }
      },
      "additionalProperties": false
    },
    "personalityConfig": {
      "type": "object",
      "required": ["traits", "voice"],
      "properties": {
        "traits": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 10,
          "description": "Core personality traits"
        },
        "voice": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Description of the persona's voice and manner"
        },
        "perspective": {
          "type": "string",
          "enum": ["first-person", "second-person", "third-person"],
          "default": "first-person",
          "description": "Default grammatical perspective"
        },
        "quirks": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5,
          "description": "Unique mannerisms or speech patterns"
        },
        "background": {
          "type": "string",
          "maxLength": 1000,
          "description": "Background context for the persona"
        }
      },
      "additionalProperties": false
    },
    "languageConfig": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "default": "en-US",
          "description": "Primary language code (e.g., 'en-US', 'fr')"
        },
        "vocabulary": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["simple", "standard", "professional", "technical", "academic"],
              "default": "standard",
              "description": "Vocabulary complexity level"
            },
            "jargonAllowed": {
              "type": "boolean",
              "default": false,
              "description": "Whether domain-specific jargon is permitted"
            },
            "jargonDomains": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Domains where jargon is acceptable"
            }
          },
          "additionalProperties": false
        },
        "sentenceStructure": {
          "type": "object",
          "properties": {
            "averageLength": {
              "type": "string",
              "enum": ["short", "medium", "long", "varied"],
              "default": "medium",
              "description": "Typical sentence length"
            },
            "complexity": {
              "type": "string",
              "enum": ["simple", "moderate", "complex", "varied"],
              "default": "moderate",
              "description": "Sentence structure complexity"
            },
            "variety": {
              "type": "boolean",
              "default": true,
              "description": "Whether to vary sentence structure"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wordChoiceConfig": {
      "type": "object",
      "properties": {
        "preferred": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "instead_of"],
            "properties": {
              "word": {
                "type": "string",
                "description": "Preferred word to use"
              },
              "instead_of": {
                "type": "string",
                "description": "Word to replace"
              },
              "context": {
                "type": "string",
                "description": "Context where substitution applies"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 50,
          "description": "Preferred word substitutions"
        },
        "avoided": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 100,
          "description": "Words to avoid using"
        },
        "signature_phrases": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20,
          "description": "Characteristic phrases for the persona"
        },
        "contractions": {
          "type": "string",
          "enum": ["none", "minimal", "moderate", "frequent"],
          "default": "moderate",
          "description": "Frequency of contraction usage"
        },
        "intensifiers": {
          "type": "string",
          "enum": ["none", "minimal", "moderate", "frequent"],
          "default": "minimal",
          "description": "Frequency of intensifier words (very, really, etc.)"
        }
      },
      "additionalProperties": false
    },
    "emotionConfig": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "description": "Default emotional state (e.g., 'calm-confident', 'warm-engaged')"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "empathy",
              "enthusiasm",
              "concern",
              "joy",
              "gratitude",
              "determination",
              "curiosity",
              "encouragement",
              "reassurance",
              "urgency",
              "disappointment",
              "hope",
              "pride",
              "compassion"
            ]
          },
          "maxItems": 10,
          "description": "Allowed emotional expressions"
        },
        "intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Emotional intensity level"
        },
        "expressiveness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "How openly emotions are expressed"
        }
      },
      "additionalProperties": false
    },
    "contextModifier": {
      "type": "object",
      "description": "Overrides to apply in specific contexts",
      "properties": {
        "tone": {
          "type": "object",
          "properties": {
            "formality": { "type": "integer", "minimum": 1, "maximum": 10 },
            "warmth": { "type": "integer", "minimum": 1, "maximum": 10 },
            "assertiveness": { "type": "integer", "minimum": 1, "maximum": 10 },
            "humor": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "emotion": {
          "type": "object",
          "properties": {
            "baseline": { "type": "string" },
            "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
            "expressiveness": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "language": {
          "type": "object",
          "properties": {
            "vocabulary": {
              "type": "object",
              "properties": {
                "level": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
