{
  "version": "1.0",
  "metadata": {
    "name": "Edit Audio Tool",
    "description": "Tool registry integration for audio editing using ffmpeg - splice, overlay, balance, slice, and remix audio with volume control",
    "author": "automated-developer",
    "created": "2026-01-17T00:00:00Z",
    "tags": ["audio-editing", "ffmpeg", "mixing", "splice", "overlay", "volume", "tool-registry"]
  },
  "globalContext": {
    "audioEngine": "ffmpeg with libavfilter",
    "supportedFormats": "WAV, MP3, OGG, FLAC, AAC, M4A, AIFF",
    "operations": "splice, slice, overlay, concatenate, mix, volume, fade, trim, normalize, pan, equalize",
    "sampleRates": "8000, 11025, 22050, 44100, 48000, 96000 Hz",
    "channels": "mono, stereo, 5.1 surround",
    "bitDepths": "16-bit, 24-bit, 32-bit float"
  },
  "goals": [
    {
      "id": "setup-project",
      "objective": "Initialize project with ffmpeg bindings and audio processing utilities",
      "priority": 1,
      "criteria": {
        "success": [
          "Project structure with ffmpeg wrapper module",
          "Audio file validation and metadata extraction",
          "Temporary file management for processing",
          "Error handling for ffmpeg failures"
        ],
        "acceptance": [
          "ffmpeg version detected and validated",
          "Common audio formats load successfully",
          "Metadata extraction (duration, sample rate, channels) works"
        ],
        "validation": "automated"
      },
      "constraints": [
        "ffmpeg 4.0+ required for filter support",
        "Support both Python and Rust implementations",
        "Handle large files without memory issues"
      ],
      "context": {
        "pythonDeps": "ffmpeg-python, pydub (optional fallback)",
        "rustDeps": "ffmpeg-next crate or subprocess",
        "ffprobeUsage": "ffprobe -v quiet -print_format json -show_format -show_streams input.wav"
      }
    },
    {
      "id": "implement-audio-info",
      "objective": "Implement audio file analysis and metadata extraction",
      "priority": 1,
      "criteria": {
        "success": [
          "get_info(path) returns AudioInfo with all metadata",
          "Duration in milliseconds and formatted string",
          "Sample rate, channels, bit depth, codec",
          "File size and bitrate"
        ],
        "acceptance": [
          "All supported formats return accurate info",
          "Invalid files return clear error",
          "Fast metadata extraction (<100ms)"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use ffprobe for extraction",
        "Handle files without complete metadata"
      ],
      "dependencies": ["setup-project"],
      "context": {
        "audioInfo": "struct AudioInfo { duration_ms, sample_rate, channels, bit_depth, codec, bitrate_kbps, file_size_bytes }",
        "ffprobeJson": "ffprobe -v quiet -print_format json -show_format -show_streams"
      }
    },
    {
      "id": "implement-slice-operation",
      "objective": "Implement audio slicing to extract portions of audio files by time range",
      "priority": 1,
      "criteria": {
        "success": [
          "slice(input, start, end, output) extracts time range",
          "Support time formats: seconds, milliseconds, HH:MM:SS.mmm",
          "Preserve audio quality (no re-encoding when possible)",
          "Handle edge cases: start > end, out of bounds"
        ],
        "acceptance": [
          "Extracted audio matches exact time range",
          "No quality loss with stream copy",
          "Millisecond precision"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use -ss and -t or -to flags for timing",
        "Stream copy when input/output formats match",
        "Re-encode only when necessary"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "ffmpegSlice": "ffmpeg -i input.wav -ss START -to END -c copy output.wav",
        "timeFormats": "seconds (float), milliseconds (int), timestamp (HH:MM:SS.mmm)"
      }
    },
    {
      "id": "implement-trim-operation",
      "objective": "Implement audio trimming to remove silence or specified portions from start/end",
      "priority": 2,
      "criteria": {
        "success": [
          "trim_silence(input, threshold_db, min_duration) removes silence",
          "trim_start(input, duration) removes from beginning",
          "trim_end(input, duration) removes from end",
          "Auto-detect silence threshold"
        ],
        "acceptance": [
          "Silence detection accurate to -50dB default",
          "Preserves audio content",
          "Fast processing"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use silenceremove filter for auto-trim",
        "Configurable silence threshold",
        "Preserve small intentional gaps"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "silenceRemove": "ffmpeg -i input.wav -af silenceremove=start_periods=1:start_silence=0.1:start_threshold=-50dB output.wav",
        "trimStart": "ffmpeg -i input.wav -ss DURATION -c copy output.wav",
        "trimEnd": "Calculate new duration, use -t flag"
      }
    },
    {
      "id": "implement-concatenate-operation",
      "objective": "Implement audio concatenation to join multiple files sequentially",
      "priority": 1,
      "criteria": {
        "success": [
          "concatenate(inputs[], output) joins files in order",
          "Handle different sample rates via resampling",
          "Optional crossfade between segments",
          "Preserve or normalize channel count"
        ],
        "acceptance": [
          "Output duration equals sum of inputs (minus crossfade)",
          "No clicks or pops at boundaries",
          "Handles 100+ input files"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use concat demuxer for same-format files",
        "Use concat filter for different formats",
        "Resample to highest sample rate"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "concatDemuxer": "ffmpeg -f concat -safe 0 -i filelist.txt -c copy output.wav",
        "concatFilter": "ffmpeg -i a.wav -i b.wav -filter_complex '[0:a][1:a]concat=n=2:v=0:a=1' output.wav",
        "crossfade": "acrossfade=d=DURATION:c1=tri:c2=tri"
      }
    },
    {
      "id": "implement-overlay-operation",
      "objective": "Implement audio overlay/mixing to combine multiple audio streams at specified times",
      "priority": 1,
      "criteria": {
        "success": [
          "overlay(base, overlay, offset_ms, output) mixes at position",
          "overlay_multi(base, overlays[{path, offset, volume}]) for multiple",
          "Per-stream volume control",
          "Handle different durations correctly"
        ],
        "acceptance": [
          "Overlay positioned at exact offset",
          "Volume levels accurate",
          "Output duration = max(base, overlay+offset)"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use amix or amerge filters",
        "adelay for positioning overlay",
        "Normalize to prevent clipping"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "overlayFilter": "ffmpeg -i base.wav -i overlay.wav -filter_complex '[1:a]adelay=OFFSET_MS|OFFSET_MS[delayed];[0:a][delayed]amix=inputs=2:duration=longest' output.wav",
        "multiOverlay": "Build filter chain with multiple adelay and final amix"
      }
    },
    {
      "id": "implement-volume-operation",
      "objective": "Implement volume adjustment including gain, normalization, and per-channel control",
      "priority": 1,
      "criteria": {
        "success": [
          "adjust_volume(input, gain_db, output) applies gain in decibels",
          "normalize(input, target_lufs, output) loudness normalization",
          "adjust_channel_volume(input, volumes[], output) per-channel",
          "Detect and warn about clipping"
        ],
        "acceptance": [
          "Gain accurate to ±0.1dB",
          "Normalization matches target LUFS",
          "Clipping detection works"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use volume filter for simple gain",
        "Use loudnorm for LUFS normalization",
        "Use pan filter for channel control"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "volumeFilter": "ffmpeg -i input.wav -af volume=GAIN_DB:precision=float output.wav",
        "loudnormFilter": "ffmpeg -i input.wav -af loudnorm=I=-16:TP=-1.5:LRA=11 output.wav",
        "channelVolume": "ffmpeg -i input.wav -af 'pan=stereo|c0=0.8*c0|c1=1.2*c1' output.wav"
      }
    },
    {
      "id": "implement-fade-operation",
      "objective": "Implement fade in/out effects for smooth audio transitions",
      "priority": 2,
      "criteria": {
        "success": [
          "fade_in(input, duration_ms, curve, output) applies fade in",
          "fade_out(input, duration_ms, curve, output) applies fade out",
          "fade_both(input, in_ms, out_ms, output) applies both",
          "Multiple curve types: linear, exponential, logarithmic"
        ],
        "acceptance": [
          "Fade duration accurate",
          "Curve shapes correct",
          "Smooth transitions without artifacts"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use afade filter",
        "Support curve types: tri, qsin, hsin, esin, log, par, etc."
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "fadeIn": "ffmpeg -i input.wav -af 'afade=t=in:st=0:d=DURATION' output.wav",
        "fadeOut": "ffmpeg -i input.wav -af 'afade=t=out:st=START:d=DURATION' output.wav",
        "curveTypes": "tri (linear), qsin (quarter sine), hsin (half sine), log, exp, etc."
      }
    },
    {
      "id": "implement-pan-operation",
      "objective": "Implement stereo panning and channel remapping",
      "priority": 2,
      "criteria": {
        "success": [
          "pan(input, position, output) adjusts stereo position (-1 to 1)",
          "mono_to_stereo(input, output) converts mono to stereo",
          "stereo_to_mono(input, output) downmixes to mono",
          "swap_channels(input, output) swaps L/R"
        ],
        "acceptance": [
          "Pan position accurate",
          "No phase issues in conversion",
          "Channel mapping correct"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use pan filter for stereo manipulation",
        "Use channelmap for remapping"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "panFilter": "pan=stereo|c0=c0*LEFT_GAIN|c1=c1*RIGHT_GAIN",
        "monoToStereo": "ffmpeg -i mono.wav -af 'pan=stereo|c0=c0|c1=c0' stereo.wav",
        "stereoToMono": "ffmpeg -i stereo.wav -ac 1 mono.wav"
      }
    },
    {
      "id": "implement-speed-operation",
      "objective": "Implement playback speed and pitch adjustment",
      "priority": 2,
      "criteria": {
        "success": [
          "change_speed(input, factor, output) adjusts speed (affects pitch)",
          "change_tempo(input, factor, output) adjusts speed (preserves pitch)",
          "change_pitch(input, semitones, output) adjusts pitch (preserves speed)",
          "Speed range: 0.5x to 2.0x"
        ],
        "acceptance": [
          "Speed factor accurate",
          "Pitch preservation quality acceptable",
          "No artifacts at moderate adjustments"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use atempo filter for tempo (pitch-preserve)",
        "Use asetrate for pitch (speed-preserve)",
        "Chain atempo filters for >2x changes"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "speedChange": "ffmpeg -i input.wav -af 'atempo=FACTOR' output.wav (0.5-2.0 per filter)",
        "pitchChange": "ffmpeg -i input.wav -af 'asetrate=SAMPLE_RATE*FACTOR,aresample=SAMPLE_RATE' output.wav",
        "tempoChain": "For 4x: atempo=2.0,atempo=2.0"
      }
    },
    {
      "id": "implement-eq-operation",
      "objective": "Implement equalizer and frequency filtering",
      "priority": 3,
      "criteria": {
        "success": [
          "eq_band(input, freq, gain_db, q, output) parametric EQ",
          "highpass(input, freq, output) high-pass filter",
          "lowpass(input, freq, output) low-pass filter",
          "bandpass(input, low_freq, high_freq, output) band-pass filter"
        ],
        "acceptance": [
          "Filter frequencies accurate",
          "Gain in dB accurate",
          "Q factor affects bandwidth correctly"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use equalizer filter for parametric EQ",
        "Use highpass, lowpass filters",
        "Reasonable frequency range: 20Hz-20kHz"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "eqFilter": "ffmpeg -i input.wav -af 'equalizer=f=FREQ:width_type=q:width=Q:g=GAIN_DB' output.wav",
        "highpassFilter": "ffmpeg -i input.wav -af 'highpass=f=FREQ' output.wav",
        "lowpassFilter": "ffmpeg -i input.wav -af 'lowpass=f=FREQ' output.wav"
      }
    },
    {
      "id": "implement-effects-operation",
      "objective": "Implement common audio effects: reverb, echo, chorus",
      "priority": 3,
      "criteria": {
        "success": [
          "add_reverb(input, room_size, damping, output) adds reverb",
          "add_echo(input, delay_ms, decay, output) adds echo",
          "add_chorus(input, depth, rate, output) adds chorus",
          "Configurable wet/dry mix"
        ],
        "acceptance": [
          "Effects audibly correct",
          "Parameters affect output appropriately",
          "No severe artifacts"
        ],
        "validation": "hybrid"
      },
      "constraints": [
        "Use aecho, chorus filters",
        "Reverb may require external impulse response",
        "Document limitations"
      ],
      "dependencies": ["implement-audio-info"],
      "context": {
        "echoFilter": "ffmpeg -i input.wav -af 'aecho=0.8:0.88:DELAY_MS:DECAY' output.wav",
        "chorusFilter": "ffmpeg -i input.wav -af 'chorus=0.5:0.9:50|60|40:0.4|0.32|0.3:0.25|0.4|0.3:2|2.3|1.3' output.wav",
        "reverbNote": "ffmpeg has limited reverb; consider afir with impulse response"
      }
    },
    {
      "id": "implement-batch-processor",
      "objective": "Implement batch processing for applying operations to multiple files",
      "priority": 3,
      "criteria": {
        "success": [
          "batch_process(inputs[], operation, params, output_dir) processes all",
          "Parallel processing with configurable workers",
          "Progress reporting per file",
          "Error handling per file (continue on failure)"
        ],
        "acceptance": [
          "All files processed correctly",
          "Parallel processing speeds up batch",
          "Failures don't stop entire batch"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Limit concurrent ffmpeg processes",
        "Output naming: original_name + suffix or to output_dir"
      ],
      "dependencies": ["implement-volume-operation", "implement-slice-operation"],
      "context": {
        "parallelism": "CPU count or configurable max workers",
        "outputNaming": "{original_stem}_{operation}.{format}"
      }
    },
    {
      "id": "implement-pipeline-operation",
      "objective": "Implement operation chaining to apply multiple effects in sequence",
      "priority": 2,
      "criteria": {
        "success": [
          "pipeline(input, operations[], output) chains operations",
          "Single ffmpeg call for filter chain when possible",
          "Intermediate outputs for incompatible operations",
          "Pipeline validation before execution"
        ],
        "acceptance": [
          "Chained operations produce correct output",
          "Single-pass processing where possible",
          "Clear error if operations incompatible"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Chain audio filters with commas in -af",
        "Some operations require separate passes"
      ],
      "dependencies": ["implement-volume-operation", "implement-fade-operation", "implement-eq-operation"],
      "context": {
        "filterChain": "ffmpeg -i input.wav -af 'volume=1.5,afade=t=in:d=2,highpass=f=80' output.wav",
        "pipelineFormat": "[{\"op\": \"volume\", \"gain_db\": 3}, {\"op\": \"fade_in\", \"duration_ms\": 2000}]"
      }
    },
    {
      "id": "define-tool-schema",
      "objective": "Define JSON schema for edit_audio tool interface",
      "priority": 2,
      "criteria": {
        "success": [
          "Input schema: action, input_path(s), parameters, output_path",
          "Output schema: output_path, duration_ms, operations_applied",
          "Action types for each operation: slice, trim, concat, overlay, volume, fade, pan, speed, eq, effects, pipeline"
        ],
        "acceptance": [
          "Schema validates with JSON Schema Draft-07",
          "All parameters documented",
          "Parameter validation for ranges"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Time parameters accept multiple formats",
        "Volume in dB, not linear",
        "Frequency in Hz"
      ],
      "dependencies": ["setup-project"],
      "context": {
        "actions": "info | slice | trim | concat | overlay | volume | normalize | fade | pan | speed | tempo | pitch | eq | highpass | lowpass | echo | chorus | pipeline | batch",
        "timeParams": "Accepts: seconds (float), milliseconds (int with 'ms' suffix), timestamp (HH:MM:SS.mmm)",
        "volumeParams": "gain_db: float (-60 to +20), target_lufs: float (-24 to -9)"
      }
    },
    {
      "id": "implement-tool-handler",
      "objective": "Implement tool registry handler for JSON request processing",
      "priority": 1,
      "criteria": {
        "success": [
          "handle(input: dict) -> dict dispatches actions",
          "All operations accessible via handler",
          "Input validation with clear errors",
          "Output includes operation metadata"
        ],
        "acceptance": [
          "All actions return valid JSON per schema",
          "Errors descriptive and actionable",
          "Temp files cleaned up"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Validate file exists before processing",
        "Timeout for long operations",
        "Return paths, not audio data"
      ],
      "dependencies": [
        "implement-slice-operation",
        "implement-concatenate-operation",
        "implement-overlay-operation",
        "implement-volume-operation",
        "implement-fade-operation",
        "implement-pipeline-operation",
        "define-tool-schema"
      ],
      "context": {
        "entryPoint": "async def handle(input: dict) -> dict",
        "errorCodes": "FILE_NOT_FOUND, INVALID_FORMAT, INVALID_PARAMS, FFMPEG_ERROR, TIMEOUT"
      }
    },
    {
      "id": "implement-cli",
      "objective": "Create CLI for standalone audio editing operations",
      "priority": 3,
      "criteria": {
        "success": [
          "edit-audio slice input.wav -s 0 -e 10 -o output.wav",
          "edit-audio volume input.wav --gain 3 -o louder.wav",
          "edit-audio concat a.wav b.wav c.wav -o merged.wav",
          "edit-audio overlay base.wav overlay.wav --offset 5000 -o mixed.wav"
        ],
        "acceptance": [
          "All operations accessible via CLI",
          "Help text documents all options",
          "Progress indicator for long operations"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Use argparse or click with subcommands",
        "Consistent flag naming across operations",
        "Exit codes: 0 success, 1 error"
      ],
      "dependencies": ["implement-tool-handler"],
      "context": {
        "cliSubcommands": "info, slice, trim, concat, overlay, volume, normalize, fade, pan, speed, tempo, pitch, eq, highpass, lowpass, effects, pipeline, batch"
      }
    },
    {
      "id": "write-tests",
      "objective": "Write tests for all audio editing operations",
      "priority": 3,
      "criteria": {
        "success": [
          "Unit tests for parameter validation",
          "Integration tests for each operation with real ffmpeg",
          "Output verification (duration, format, etc.)",
          "Edge case tests (empty files, zero duration, etc.)"
        ],
        "acceptance": [
          "Tests pass with ffmpeg installed",
          "Coverage >70%",
          "Test audio fixtures included"
        ],
        "validation": "automated"
      },
      "constraints": [
        "Generate test audio programmatically or include fixtures",
        "Verify output properties, not waveform content"
      ],
      "dependencies": ["implement-tool-handler"],
      "context": {
        "testFixtures": "1-second sine wave, stereo test, various sample rates",
        "verificationMethod": "ffprobe output properties match expected"
      }
    },
    {
      "id": "write-documentation",
      "objective": "Write documentation for all audio editing operations and usage",
      "priority": 4,
      "criteria": {
        "success": [
          "README with operation catalog",
          "Parameter reference for each operation",
          "Examples for common use cases",
          "API reference"
        ],
        "acceptance": [
          "All operations documented with examples",
          "Parameter ranges documented",
          "Troubleshooting section"
        ],
        "validation": "manual"
      },
      "constraints": [
        "Include audio-specific tips",
        "Document ffmpeg version requirements"
      ],
      "dependencies": ["implement-cli"],
      "context": {
        "sections": "Overview, Installation, Quick Start, Operations Reference, CLI Reference, API, Pipeline Building, Batch Processing, Troubleshooting"
      }
    },
    {
      "id": "integrate-tool-registry",
      "objective": "Package edit_audio tool for registration with tool registry",
      "priority": 1,
      "criteria": {
        "success": [
          "tool-manifest.json defines metadata, schema, capabilities",
          "Tool exposes standard entry point",
          "Health check verifies ffmpeg available"
        ],
        "acceptance": [
          "Tool registers successfully",
          "All operations accessible",
          "ffmpeg dependency documented"
        ],
        "validation": "hybrid"
      },
      "constraints": [
        "ffmpeg 4.0+ required",
        "No bundled ffmpeg (system dependency)",
        "Document installation for each platform"
      ],
      "dependencies": [
        "implement-tool-handler",
        "define-tool-schema"
      ],
      "context": {
        "manifestName": "edit-audio",
        "manifestVersion": "1.0.0",
        "manifestDescription": "Audio editing tool using ffmpeg - splice, overlay, mix, adjust volume, apply effects",
        "capabilities": "audio-editing, mixing, volume-control, effects, format-conversion",
        "resourceCpu": "1+ cores (more for batch processing)",
        "resourceMemory": "256MB minimum",
        "resourceDisk": "Temp space for processing",
        "externalDeps": "ffmpeg 4.0+"
      }
    }
  ]
}
